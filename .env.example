# Firebase 클라이언트 설정은 src/lib/firebase.ts에 연결되어 있습니다.
# 채팅·추억 백엔드 연동 시 아래 API 주소를 사용하세요.
VITE_API_URL=https://api.example.com
VITE_SOCKET_URL=wss://api.example.com

# NAVER Cloud Maps > Route Application의 Client ID만 넣으세요.
# Client Secret은 절대 프론트엔드 .env에 넣지 않습니다.
VITE_NAVER_MAP_CLIENT_ID=YOUR_NAVER_MAP_CLIENT_ID

# Worker 배포 후 공개 HTTPS 주소만 입력합니다. TURN API 토큰은 넣지 않습니다.
# 비워 두면 미배포 서버에 요청하지 않고 기존 직접 연결을 시도합니다.
VITE_TURN_CREDENTIALS_URL=

# NAVER Developers 지역 검색: 서버 함수 배포 후 공개 HTTPS 주소만 기입합니다.
# 지역 검색용 Client ID/Secret은 Firebase Secret Manager에만 보관하세요.
VITE_NAVER_LOCAL_SEARCH_URL=
