rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function memberOf(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && get(/databases/$(database)/documents/couples/$(coupleId)).data.memberUids.size() == 2
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberUids;
    }

    function sharesCoupleWith(uid) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(uid))
        && currentUser().data.coupleId != null
        && memberOf(currentUser().data.coupleId)
        && (get(/databases/$(database)/documents/users/$(uid)).data.get('coupleId', '') == currentUser().data.coupleId
          || verifiedInvite(currentUser().data.coupleId))
        && uid in get(/databases/$(database)/documents/couples/$(currentUser().data.coupleId)).data.memberUids;
    }

    function verifiedInvite(coupleId) {
      let pair = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      let code = pair.get('inviteCode', '');
      return code != '' && matchingInvite(code, coupleId, pair.memberUids);
    }

    function matchingInvite(code, coupleId, members) {
      let invite = get(/databases/$(database)/documents/coupleInvites/$(code)).data;
      return invite.status == 'accepted' && invite.coupleId == coupleId
        && members == [invite.ownerUid, invite.joinerUid];
    }

    // Membership is granted only by a mutually accepted invite. User profile
    // pointers are references, never an independent source of authorization.
    function hasLiveCouple(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return containsMember(uid, user.get('coupleId', ''))
        || reservedMembership(uid, user.get('pendingInviteCode', ''));
    }

    function containsMember(uid, id) {
      return id != ''
        && exists(/databases/$(database)/documents/couples/$(id))
        && uid in get(/databases/$(database)/documents/couples/$(id)).data.memberUids;
    }

    function reservedMembership(uid, code) {
      return code != '' && exists(/databases/$(database)/documents/coupleInvites/$(code))
        && get(/databases/$(database)/documents/coupleInvites/$(code)).data.status == 'accepted'
        && containsMember(uid, get(/databases/$(database)/documents/coupleInvites/$(code)).data.coupleId);
    }

    function pendingInviteUpdate(uid) {
      let code = request.resource.data.get('pendingInviteCode', '');
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingInviteCode'])
        || (!hasLiveCouple(uid) && code != ''
          && getAfter(/databases/$(database)/documents/coupleInvites/$(code)).data.status == 'requested'
          && getAfter(/databases/$(database)/documents/coupleInvites/$(code)).data.joinerUid == uid);
    }

    function validUserPair(uid) {
      let id = request.resource.data.get('coupleId', '');
      let partner = request.resource.data.get('partnerUid', '');
      let pair = getAfter(/databases/$(database)/documents/couples/$(id)).data;
      return id != '' && partner != uid
        && pair.memberUids.size() == 2
        && uid in pair.memberUids && partner in pair.memberUids;
    }

    function userPairUpdate(uid) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let oldId = resource.data.get('coupleId', '');
      return !changed.hasAny(['coupleId', 'partnerUid'])
        || (request.resource.data.get('coupleId', '') == ''
          && request.resource.data.get('partnerUid', '') == ''
          && (oldId == '' || !(uid in getAfter(/databases/$(database)/documents/couples/$(oldId)).data.memberUids)))
        || (request.resource.data.get('coupleId', '') != '' && validUserPair(uid));
    }

    function acceptedCreation(coupleId) {
      let code = request.resource.data.inviteCode;
      let before = get(/databases/$(database)/documents/coupleInvites/$(code)).data;
      let after = getAfter(/databases/$(database)/documents/coupleInvites/$(code)).data;
      return before.status == 'requested'
        && before.ownerUid == request.auth.uid
        && before.expiresAt > request.time.toMillis()
        && !hasLiveCouple(before.ownerUid) && !hasLiveCouple(before.joinerUid)
        && get(/databases/$(database)/documents/users/$(before.joinerUid)).data.pendingInviteCode == code
        && after.status == 'accepted' && after.coupleId == coupleId
        && request.resource.data.memberUids == [before.ownerUid, before.joinerUid]
        && getAfter(/databases/$(database)/documents/users/$(before.ownerUid)).data.coupleId == coupleId;
    }

    function disconnectOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'memberUids', 'status', 'disconnectedBy', 'disconnectedAt', 'updatedAt'
        ])
        && request.resource.data.memberUids == []
        && request.resource.data.status == 'disconnected'
        && request.resource.data.disconnectedBy == request.auth.uid
        && request.resource.data.disconnectedAt == request.time
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('coupleId', '') == '';
    }

    function onlyOwnReaction(items) {
      return items.size() <= 2
        && (items.size() == 0 || items[0].uid == request.auth.uid)
        && (items.size() < 2 || items[1].uid == request.auth.uid);
    }

    function messageMetadataUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let before = resource.data.get('reactions', []);
      let after = request.resource.data.get('reactions', []);
      let oldHidden = resource.data.get('hiddenFor', []).toSet();
      let newHidden = request.resource.data.get('hiddenFor', []).toSet();
      return changed.hasOnly(['reactions', 'hiddenFor', 'read', 'lastSavedBy'])
        && (!changed.hasAny(['reactions']) || (after.size() <= 2
          && onlyOwnReaction(after.removeAll(before)) && onlyOwnReaction(before.removeAll(after))))
        && (!changed.hasAny(['hiddenFor']) || (
          newHidden.difference(oldHidden).hasOnly([request.auth.uid])
          && oldHidden.difference(newHidden).hasOnly([request.auth.uid])))
        && (!changed.hasAny(['read']) || (resource.data.authorUid != request.auth.uid && request.resource.data.read == true))
        && (!changed.hasAny(['lastSavedBy']) || request.resource.data.lastSavedBy == request.auth.uid);
    }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('coupleId', '') == ''
        && request.resource.data.get('pendingInviteCode', '') == ''
        && request.resource.data.get('partnerUid', '') == '';
      allow read: if signedIn() && (request.auth.uid == uid || sharesCoupleWith(uid));
      allow update: if signedIn() && request.auth.uid == uid && userPairUpdate(uid) && pendingInviteUpdate(uid);
      allow delete: if false;

      match /backups/{backupId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /coupleInvites/{code} {
      allow get: if signedIn();
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.code == code
        && !hasLiveCouple(request.auth.uid)
        && request.resource.data.expiresAt > request.time.toMillis()
        && request.resource.data.expiresAt <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000 + 5 * 60 * 1000
        && request.resource.data.keys().hasOnly(['code', 'ownerUid', 'ownerName', 'status', 'expiresAt', 'createdAt']);

      allow update: if signedIn() && (
        (
          resource.data.status == 'open'
          && request.resource.data.status == 'requested'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.ownerName == resource.data.ownerName
          && request.resource.data.code == resource.data.code
          && request.resource.data.expiresAt == resource.data.expiresAt
          && request.resource.data.joinerUid == request.auth.uid
          && request.auth.uid != resource.data.ownerUid
          && resource.data.expiresAt > request.time.toMillis()
          && !hasLiveCouple(request.auth.uid) && !hasLiveCouple(resource.data.ownerUid)
          && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.pendingInviteCode == code
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'joinerUid', 'joinerName', 'requestedAt'])
        )
        ||
        (
          resource.data.status == 'requested'
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.joinerUid == resource.data.joinerUid
          && request.resource.data.coupleId != null
          && resource.data.expiresAt > request.time.toMillis()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'coupleId', 'acceptedAt'])
          && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.inviteCode == code
          && getAfter(/databases/$(database)/documents/couples/$(request.resource.data.coupleId)).data.memberUids == [resource.data.ownerUid, resource.data.joinerUid]
        )
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid
        && (resource.data.status != 'accepted' || !containsMember(request.auth.uid, resource.data.coupleId));
    }

    match /couples/{coupleId} {
      allow create: if signedIn()
        && request.resource.data.testMode == false
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid == request.resource.data.createdBy
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.id == coupleId
        && acceptedCreation(coupleId);
      allow read: if memberOf(coupleId);
      allow update: if memberOf(coupleId)
        && (disconnectOnly() || !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'id', 'memberUids', 'members', 'createdBy', 'testMode', 'createdAt', 'inviteCode',
          'status', 'disconnectedBy', 'disconnectedAt'
        ]));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId)
          && request.resource.data.createdAt == request.time
          && request.resource.data.read == false
          && request.resource.data.get('hiddenFor', []) == []
          && request.resource.data.get('reactions', []) == []
          && (request.resource.data.authorUid == request.auth.uid
            || (request.resource.data.type == 'call'
              && request.resource.data.keys().hasOnly(['id', 'authorUid', 'type', 'callId', 'callKind', 'callStatus', 'callDuration', 'timestamp', 'createdAt', 'read'])
              && request.resource.data.authorUid == get(/databases/$(database)/documents/couples/$(coupleId)).data.activeCall.callerUid
              && request.resource.data.callId == get(/databases/$(database)/documents/couples/$(coupleId)).data.activeCall.callId
              && request.resource.data.id == getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.activeCall.callLogMessageId));
        allow update: if memberOf(coupleId) && (messageMetadataUpdate()
          || (resource.data.authorUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['imageUrl', 'imageUrls'])));
        allow delete: if memberOf(coupleId) && resource.data.authorUid == request.auth.uid
          && resource.data.createdAt is timestamp
          && request.time >= resource.data.createdAt
          && request.time < resource.data.createdAt + duration.value(10, 'm');
      }

      match /typing/{uid} {
        allow read: if memberOf(coupleId);
        allow create, update, delete: if memberOf(coupleId) && request.auth.uid == uid;
      }

      match /memories/{memoryId} {
        allow read, create, update, delete: if memberOf(coupleId);
      }

      match /locations/{locationId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId)
          && request.resource.data.ownerUid == request.auth.uid;
        allow update: if memberOf(coupleId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if memberOf(coupleId)
          && resource.data.ownerUid == request.auth.uid;
      }

      // Shared FUTURE date plans only. These collections never contain raw GPS,
      // automatically inferred visits, or confirmed joint footprints.
      match /datePlaces/{placeId} {
        function placeFields() {
          return request.resource.data.keys().hasOnly([
            'id', 'name', 'address', 'latitude', 'longitude', 'category', 'memo',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasAll([
            'id', 'name', 'address', 'latitude', 'longitude', 'category', 'memo',
            'createdBy', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.id == placeId
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
          && request.resource.data.address is string && request.resource.data.address.size() <= 240
          && request.resource.data.memo is string && request.resource.data.memo.size() <= 1000
          && request.resource.data.category in ['맛집', '카페', '놀거리', '여행', '기타']
          && request.resource.data.latitude is number && request.resource.data.latitude >= -90 && request.resource.data.latitude <= 90
          && request.resource.data.longitude is number && request.resource.data.longitude >= -180 && request.resource.data.longitude <= 180;
        }
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId) && placeFields()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if memberOf(coupleId) && placeFields()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memo', 'category', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if memberOf(coupleId);

        match /likes/{uid} {
          allow read: if memberOf(coupleId)
            && exists(/databases/$(database)/documents/couples/$(coupleId)/datePlaces/$(placeId));
          allow create: if memberOf(coupleId) && request.auth.uid == uid
            && exists(/databases/$(database)/documents/couples/$(coupleId)/datePlaces/$(placeId))
            && request.resource.data.keys().hasOnly(['uid', 'liked'])
            && request.resource.data.uid == uid && request.resource.data.liked == true;
          allow delete: if memberOf(coupleId) && request.auth.uid == uid;
          allow update: if false;
        }

        match /opinions/{opinionId} {
          allow read: if memberOf(coupleId)
            && exists(/databases/$(database)/documents/couples/$(coupleId)/datePlaces/$(placeId));
          allow create: if memberOf(coupleId)
            && exists(/databases/$(database)/documents/couples/$(coupleId)/datePlaces/$(placeId))
            && request.resource.data.keys().hasOnly(['id', 'authorUid', 'text', 'createdAt'])
            && request.resource.data.id == opinionId
            && request.resource.data.authorUid == request.auth.uid
            && request.resource.data.text is string && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt == request.time;
          allow delete: if memberOf(coupleId) && resource.data.authorUid == request.auth.uid;
          allow update: if false;
        }
      }

      match /dateCourses/{courseId} {
        function validCourse() {
          return request.resource.data.keys().hasOnly(['id', 'title', 'date', 'placeIds', 'timeSlots', 'createdBy', 'updatedAt'])
            && request.resource.data.keys().hasAll(['id', 'title', 'date', 'placeIds', 'createdBy', 'updatedAt'])
            && request.resource.data.id == courseId
            && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 100
            && request.resource.data.date is string && (request.resource.data.date == '' || request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
            && request.resource.data.placeIds is list
            && request.resource.data.placeIds.size() >= 1 && request.resource.data.placeIds.size() <= 20
            && (!request.resource.data.keys().hasAny(['timeSlots']) || (
              request.resource.data.timeSlots is list
              && request.resource.data.timeSlots.size() == request.resource.data.placeIds.size()
              && request.resource.data.timeSlots.size() <= 20
            ));
        }
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId) && validCourse()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.updatedAt == request.time;
        allow update: if memberOf(coupleId) && validCourse()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'date', 'placeIds', 'timeSlots', 'updatedAt'])
          && request.resource.data.updatedAt == request.time;
        allow delete: if memberOf(coupleId);
      }

      match /schedules/{scheduleId} {
        allow read: if memberOf(coupleId);
        allow create: if memberOf(coupleId)
          && request.resource.data.ownerId == request.auth.uid;
        allow update, delete: if memberOf(coupleId)
          && resource.data.ownerId == request.auth.uid;
      }
    }
  }
}
