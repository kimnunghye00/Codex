rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberOf(coupleId) {
      return signedIn()
        && firestore.exists(/databases/(default)/documents/couples/$(coupleId))
        && firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberUids.size() == 2
        && request.auth.uid in firestore.get(/databases/(default)/documents/couples/$(coupleId)).data.memberUids;
    }

    match /users/{uid}/backupMedia/{allPaths=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /couples/{coupleId}/chatMedia/{ownerUid}/{messageId}/{fileName} {
      allow read: if memberOf(coupleId);
      allow create, update: if memberOf(coupleId)
        && request.auth.uid == ownerUid
        && request.resource.contentType.matches('image/.*');
      allow delete: if memberOf(coupleId) && request.auth.uid == ownerUid;
    }
  }
}
