{
  "name": "route-couple-app",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "stability:flow": "node scripts/route-flow-smoke.mjs",
    "stability:native": "node scripts/route-native-smoke.mjs",
    "stability:cross": "node scripts/route-cross-validate.mjs",
    "stability": "npm run build && npm run stability:flow && npm run stability:native && npm run stability:cross",
    "native:sync": "npm run build && npx cap sync",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npx cap add ios",
    "native:configure": "node scripts/configure-native.mjs",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "latest",
    "@capacitor/app": "latest",
    "@capacitor/camera": "latest",
    "@capacitor/core": "latest",
    "@capacitor/device": "latest",
    "@capacitor/filesystem": "latest",
    "@capacitor/geolocation": "latest",
    "@capacitor/haptics": "latest",
    "@capacitor/ios": "latest",
    "@capacitor/keyboard": "latest",
    "@capacitor/local-notifications": "latest",
    "@capacitor/preferences": "latest",
    "@capacitor/push-notifications": "latest",
    "@capacitor/splash-screen": "latest",
    "@capacitor/status-bar": "latest",
    "@vitejs/plugin-react": "latest",
    "firebase": "^12.18.0",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "latest",
    "@eslint/js": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript-eslint": "latest"
  }
}
