{
  "name": "route-couple-app",
  "private": true,
  "version": "0.2.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview --host 0.0.0.0",
    "stability:runtime": "node --experimental-strip-types --test tests/route-runtime.test.ts",
    "stability:flow": "node scripts/route-flow-smoke.mjs",
    "stability:native": "node scripts/route-native-smoke.mjs",
    "stability:cross": "node scripts/route-cross-validate.mjs",
    "stability:deps": "node scripts/route-dependency-smoke.mjs",
    "stability:bundle": "node scripts/route-bundle-smoke.mjs",
    "stability": "npm run build && npm run stability:runtime && npm run stability:flow && npm run stability:native && npm run stability:cross && npm run stability:deps && npm run stability:bundle",
    "native:sync": "npm run build && npx cap sync",
    "native:add:android": "npx cap add android",
    "native:add:ios": "npx cap add ios",
    "native:configure": "node scripts/configure-native.mjs",
    "android:open": "npx cap open android",
    "ios:open": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.1",
    "@capacitor/app": "8.1.1",
    "@capacitor/camera": "8.2.4",
    "@capacitor/core": "8.5.1",
    "@capacitor/device": "8.0.3",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.5.1",
    "@capacitor/keyboard": "8.0.5",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/push-notifications": "8.1.2",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.3",
    "@vitejs/plugin-react": "6.1.1",
    "firebase": "12.18.0",
    "lucide-react": "1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "6.0.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "tailwindcss": "4.3.3",
    "typescript-eslint": "8.68.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
